{
	auto_https off
}

:8080 {
	encode gzip

	root * /app

	handle /env.js {
		header Content-Type text/javascript
		header Cache-Control "no-cache, no-store, must-revalidate"
		respond `window._stv_config = {"APP_API_BASE": "{$APP_API_BASE}", "APP_CAREER_PORTAL": "{$APP_CAREER_PORTAL}", "AUTH0_DOMAIN" : "{$AUTH0_DOMAIN}", "AUTH0_CLIENT_ID" : "{$AUTH0_PORTAL_CLIENT_ID}"}`
	}

	# Prevent caching of remoteEntry.js for Module Federation
	handle /assets/remoteEntry.js {
		header Access-Control-Allow-Origin "{$APP_PORTAL_BASE}"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		file_server
	}

	# Hashed assets are immutable - cache aggressively with CORS for Portal Shell
	handle /assets/* {
		header Access-Control-Allow-Origin "{$APP_PORTAL_BASE}"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /index.html {
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle {
		file_server
		try_files {path} /index.html
	}
}
